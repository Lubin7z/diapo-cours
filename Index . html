<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <link rel="manifest" href="manifest.json">
  <title>Photo → Cours</title>
  <!-- Moteur OCR -->
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@7/dist/tesseract.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      color: #111827;
    }
    .container {
      max-width: 900px;
      margin: auto;
      padding: 20px;
    }
    h1 {
      margin-bottom: 5px;
    }
    .subtitle {
      color: #6b7280;
      margin-bottom: 25px;
    }
    .card {
      background: white;
      padding: 20px;
      margin-bottom: 18px;
      border-radius: 18px;
      box-shadow: 0 4px 18px rgba(0,0,0,0.08);
    }
    button,
    .file-button {
      display: inline-block;
      border: none;
      border-radius: 12px;
      padding: 13px 18px;
      margin: 5px;
      background: #111827;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }
    button:disabled {
      opacity: 0.6;
      cursor: wait;
    }
    .secondary {
      background: #e5e7eb;
      color: #111827;
    }
    input[type="file"] {
      display: none;
    }
    #preview {
      display: none;
      width: 100%;
      max-height: 400px;
      object-fit: contain;
      margin-top: 15px;
      border-radius: 14px;
    }
    textarea {
      width: 100%;
      min-height: 230px;
      padding: 15px;
      border: 1px solid #d1d5db;
      border-radius: 12px;
      font-family: Arial, sans-serif;
      font-size: 16px;
      resize: vertical;
    }
    .status {
      background: #f3f4f6;
      padding: 13px;
      margin: 12px 0;
      border-radius: 10px;
    }
    .progress {
      width: 100%;
      height: 12px;
      background: #e5e7eb;
      border-radius: 10px;
      overflow: hidden;
      margin: 12px 0;
    }
    .progress-bar {
      width: 0%;
      height: 100%;
      background: #111827;
      transition: width 0.2s;
    }
    .course {
      line-height: 1.6;
    }
    .keyword {
      display: inline-block;
      background: #e5e7eb;
      padding: 7px 11px;
      margin: 4px;
      border-radius: 20px;
    }
    .hidden {
      display: none;
    }
  </style>
</head>
<body>
<div class="container">
  <h1>📷 Photo → Cours</h1>
  <p class="subtitle">
    Prends une photo d'un document, reconnais le texte,
    transforme-le en cours et exporte-le.
  </p>
  <!-- =========================
       PHOTO
  ========================== -->
  <div class="card">
    <h2>1. Ajouter une photo</h2>
    <label
      class="file-button"
      for="photo"
    >
      📷 Prendre / choisir une photo
    </label>
    <input
      id="photo"
      type="file"
      accept="image/*"
      capture="environment"
    >
    <button
      id="exampleButton"
      class="secondary"
    >
      🧪 Exemple
    </button>
    <img
      id="preview"
      alt="Aperçu de la photo"
    >
  </div>
  <!-- =========================
       OCR
  ========================== -->
  <div class="card">
    <h2>2. Reconnaître le texte</h2>
    <p>
      Le moteur OCR français analyse directement la photo.
    </p>
    <button id="ocrButton">
      🔎 Reconnaître le texte
    </button>
    <div
      id="ocrStatus"
      class="status"
    >
      Aucune photo analysée.
    </div>
    <div
      id="progressContainer"
      class="progress hidden"
    >
      <div
        id="progressBar"
        class="progress-bar"
      ></div>
    </div>
    <textarea
      id="text"
      placeholder="Le texte reconnu apparaîtra ici. Tu peux aussi le corriger."
    ></textarea>
  </div>
  <!-- =========================
       COURS
  ========================== -->
  <div class="card">
    <h2>3. Générer le cours</h2>
    <button id="courseButton">
      📚 Générer le cours
    </button>
    <div
      id="course"
      class="course hidden"
    ></div>
  </div>
  <!-- =========================
       EXPORT
  ========================== -->
  <div class="card">
    <h2>4. Exporter</h2>
    <button id="exportTxt">
      📄 Export TXT
    </button>
    <button
      id="exportHtml"
      class="secondary"
    >
      🌐 Export HTML
    </button>
  </div>
</div>
<script>
let imageFile = null;
let generatedCourse = null;
/* =====================================================
   SELECTION PHOTO
===================================================== */
document
  .getElementById("photo")
  .addEventListener("change", function(event) {
    imageFile = event.target.files[0];
    if (!imageFile) {
      return;
    }
    const preview =
      document.getElementById("preview");
    preview.src =
      URL.createObjectURL(imageFile);
    preview.style.display =
      "block";
    document.getElementById("ocrStatus").textContent =
      "✅ Photo prête. Clique sur « Reconnaître le texte ».";
  });
/* =====================================================
   EXEMPLE
===================================================== */
document
  .getElementById("exampleButton")
  .addEventListener("click", function() {
    const example =
`La photosynthèse est le processus par lequel les plantes utilisent l'énergie lumineuse pour transformer le dioxyde de carbone et l'eau en matière organique.
Elle produit notamment du glucose et libère du dioxygène.
La photosynthèse se déroule principalement dans les chloroplastes des cellules végétales.
La chlorophylle joue un rôle essentiel dans la capture de l'énergie lumineuse.`;
    document.getElementById("text").value =
      example;
    document.getElementById("ocrStatus").textContent =
      "🧪 Exemple chargé.";
  });
/* =====================================================
   OCR FRANÇAIS
===================================================== */
document
  .getElementById("ocrButton")
  .addEventListener("click", async function() {
    if (!imageFile) {
      document.getElementById("ocrStatus").textContent =
        "⚠️ Choisis d'abord une photo.";
      return;
    }
    const button =
      document.getElementById("ocrButton");
    const status =
      document.getElementById("ocrStatus");
    const textArea =
      document.getElementById("text");
    const progressContainer =
      document.getElementById("progressContainer");
    const progressBar =
      document.getElementById("progressBar");
    button.disabled = true;
    progressContainer.classList.remove("hidden");
    progressBar.style.width = "0%";
    status.textContent =
      "⏳ Chargement du moteur OCR français…";
    let worker = null;
    try {
      /*
       * Chargement du moteur Tesseract
       * avec le modèle français "fra".
       */
      worker =
        await Tesseract.createWorker(
          "fra",
          1,
          {
            logger: function(message) {
              if (
                message.status ===
                "loading tesseract core"
              ) {
                status.textContent =
                  "⚙️ Chargement du moteur OCR…";
              }
              else if (
                message.status ===
                "loading language traineddata"
              ) {
                status.textContent =
                  "🇫🇷 Chargement du modèle français…";
              }
              else if (
                message.status ===
                "initializing api"
              ) {
                status.textContent =
                  "⚙️ Initialisation…";
              }
              else if (
                message.status ===
                "recognizing text"
              ) {
                const progress =
                  Math.round(
                    (message.progress || 0) * 100
                  );
                progressBar.style.width =
                  progress + "%";
                status.textContent =
                  "🔎 Reconnaissance du texte : " +
                  progress +
                  "%";
              }
            }
          }
        );
      /*
       * Amélioration de la reconnaissance
       * pour du texte imprimé.
       */
      await worker.setParameters({
        tessedit_pageseg_mode:
          Tesseract.PSM.AUTO,
        preserve_interword_spaces:
          "1"
      });
      /*
       * Reconnaissance réelle de la photo.
       */
      const result =
        await worker.recognize(
          imageFile
        );
      const recognizedText =
        result.data.text.trim();
      if (!recognizedText) {
        status.textContent =
          "⚠️ Aucun texte détecté. Essaie une photo plus nette, mieux éclairée et bien cadrée.";
        return;
      }
      /*
       * Affichage du résultat.
       */
      textArea.value =
        recognizedText;
      progressBar.style.width =
        "100%";
      status.textContent =
        "✅ Texte français reconnu avec succès.";
    }
    catch (error) {
      console.error(
        "Erreur OCR :",
        error
      );
      status.textContent =
        "❌ Erreur OCR. Vérifie ta connexion Internet puis réessaie.";
    }
    finally {
      if (worker) {
        try {
          await worker.terminate();
        }
        catch (error) {
          console.log(
            "Fermeture OCR :",
            error
          );
        }
      }
      button.disabled =
        false;
    }
  });
/* =====================================================
   GENERATION DU COURS
===================================================== */
document
  .getElementById("courseButton")
  .addEventListener("click", function() {
    const raw =
      document
        .getElementById("text")
        .value
        .trim();
    if (!raw) {
      alert(
        "Ajoute d'abord du texte."
      );
      return;
    }
    /*
     * Nettoyage du texte OCR.
     */
    const clean =
      raw
        .replace(/\s+/g, " ")
        .trim();
    /*
     * Découpage en phrases.
     */
    const sentences =
      clean
        .split(/(?<=[.!?])\s+/)
        .filter(Boolean);
    /*
     * Titre.
     */
    let title =
      sentences[0] ||
      "Cours";
    title =
      title
        .replace(/[.!?]$/, "")
        .slice(0, 100);
    /*
     * Résumé.
     */
    const summary =
      sentences
        .slice(0, 2)
        .join(" ");
    /*
     * Points essentiels.
     */
    const points =
      sentences
        .slice(0, 10);
    /*
     * Extraction de mots-clés.
     */
    const words =
      clean
        .toLowerCase()
        .match(
          /[a-zàâçéèêëîïôûùüÿñæœ]{6,}/gi
        ) || [];
    const stopWords = [
      "principalement",
      "processus",
      "utilisent",
      "permettent",
      "également",
      "certaines",
      "ensuite",
      "pendant",
      "comme",
      "cette",
      "entre",
      "leurs",
      "notamment"
    ];
    const keywords =
      [
        ...new Set(words)
      ]
      .filter(
        word =>
          !stopWords.includes(
            word
          )
      )
      .slice(0, 12);
    generatedCourse = {
      title,
      summary,
      points,
      keywords
    };
    displayCourse();
  });
/* =====================================================
   AFFICHAGE COURS
===================================================== */
function displayCourse() {
  const course =
    document.getElementById("course");
  course.classList.remove(
    "hidden"
  );
  course.innerHTML = `
    <h3>
      ${escapeHTML(
        generatedCourse.title
      )}
    </h3>
    <h4>
      📝 À retenir
    </h4>
    <p>
      ${escapeHTML(
        generatedCourse.summary
      )}
    </p>
    <h4>
      📌 Points essentiels
    </h4>
    <ul>
      ${generatedCourse.points
        .map(
          point =>
            `<li>
              ${escapeHTML(point)}
            </li>`
        )
        .join("")}
    </ul>
    <h4>
      🔑 Mots-clés
    </h4>
    <div>
      ${generatedCourse.keywords
        .map(
          keyword =>
            `<span class="keyword">
              ${escapeHTML(keyword)}
            </span>`
        )
        .join("")}
    </div>
  `;
}
/* =====================================================
   PROTECTION HTML
===================================================== */
function escapeHTML(text) {
  return String(text)
    .replace(
      /[&<>"']/g,
      function(character) {
        const entities = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        };
        return entities[
          character
        ];
      }
    );
}
/* =====================================================
   TELECHARGEMENT
===================================================== */
function downloadFile(
  filename,
  content,
  type
) {
  const blob =
    new Blob(
      [content],
      {
        type: type
      }
    );
  const url =
    URL.createObjectURL(
      blob
    );
  const link =
    document.createElement(
      "a"
    );
  link.href =
    url;
  link.download =
    filename;
  document.body.appendChild(
    link
  );
  link.click();
  link.remove();
  setTimeout(
    function() {
      URL.revokeObjectURL(
        url
      );
    },
    1000
  );
}
/* =====================================================
   EXPORT TXT
===================================================== */
document
  .getElementById("exportTxt")
  .addEventListener("click", function() {
    if (!generatedCourse) {
      alert(
        "Génère d'abord le cours."
      );
      return;
    }
    const content =
`${generatedCourse.title}
À RETENIR
${generatedCourse.summary}
POINTS ESSENTIELS
${generatedCourse.points
  .map(
    point =>
      "• " + point
  )
  .join("\n")}
MOTS-CLÉS
${generatedCourse.keywords.join(", ")}
`;
    downloadFile(
      "cours.txt",
      content,
      "text/plain;charset=utf-8"
    );
  });
/* =====================================================
   EXPORT HTML
===================================================== */
document
  .getElementById("exportHtml")
  .addEventListener("click", function() {
    if (!generatedCourse) {
      alert(
        "Génère d'abord le cours."
      );
      return;
    }
    const html = `
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>
${escapeHTML(
  generatedCourse.title
)}
</title>
</head>
<body>
<h1>
${escapeHTML(
  generatedCourse.title
)}
</h1>
<h2>
À retenir
</h2>
<p>
${escapeHTML(
  generatedCourse.summary
)}
</p>
<h2>
Points essentiels
</h2>
<ul>
${generatedCourse.points
  .map(
    point =>
      `<li>
        ${escapeHTML(point)}
      </li>`
  )
  .join("")}
</ul>
<h2>
Mots-clés
</h2>
<p>
${generatedCourse.keywords
  .map(
    keyword =>
      escapeHTML(keyword)
  )
  .join(" • ")}
</p>
</body>
</html>
`;
    downloadFile(
      "cours.html",
      html,
      "text/html;charset=utf-8"
    );
  });
/* =====================================================
   SERVICE WORKER
===================================================== */
if (
  "serviceWorker" in navigator
) {
  window.addEventListener(
    "load",
    function() {
      navigator.serviceWorker
        .register(
          "sw.js"
        )
        .then(
          function() {
            console.log(
              "Service Worker actif."
            );
          }
        )
        .catch(
          function(error) {
            console.log(
              "Service Worker :",
              error
            );
          }
        );
    }
  );
}
</script>
</body>
</html>
