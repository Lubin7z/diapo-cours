<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111827">
  <link rel="manifest" href="manifest.json">
  <title>Photo → Cours</title>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f3f4f6;
      color: #111827;
    }
    .container {
      max-width: 900px;
      margin: auto;
      padding: 24px;
    }
    h1 {
      margin-bottom: 8px;
    }
    .subtitle {
      color: #6b7280;
      margin-bottom: 25px;
    }
    .card {
      background: white;
      padding: 20px;
      margin-bottom: 18px;
      border-radius: 18px;
      box-shadow: 0 4px 20px rgba(0,0,0,.08);
    }
    button,
    .file-button {
      display: inline-block;
      border: none;
      border-radius: 12px;
      padding: 12px 18px;
      background: #111827;
      color: white;
      font-weight: 700;
      cursor: pointer;
      margin: 5px;
    }
    button.secondary {
      background: #e5e7eb;
      color: #111827;
    }
    input[type="file"] {
      display: none;
    }
    #preview {
      display: none;
      width: 100%;
      max-height: 400px;
      object-fit: contain;
      margin-top: 15px;
      border-radius: 12px;
    }
    textarea {
      width: 100%;
      min-height: 220px;
      padding: 14px;
      border: 1px solid #d1d5db;
      border-radius: 12px;
      font: inherit;
      resize: vertical;
    }
    .status {
      background: #f3f4f6;
      padding: 12px;
      border-radius: 10px;
      margin: 12px 0;
    }
    .course {
      line-height: 1.6;
    }
    .keyword {
      display: inline-block;
      background: #e5e7eb;
      padding: 6px 10px;
      border-radius: 20px;
      margin: 4px;
    }
    .hidden {
      display: none;
    }
  </style>
</head>
<body>
<div class="container">
  <h1>📷 Photo → Cours</h1>
  <p class="subtitle">
    Photographier ou importer un document, récupérer son texte,
    créer un cours et l’exporter.
  </p>
  <!-- PHOTO -->
  <div class="card">
    <h2>1. Ajouter une photo</h2>
    <label class="file-button" for="photo">
      📷 Choisir une photo
    </label>
    <input
      id="photo"
      type="file"
      accept="image/*"
      capture="environment"
    >
    <button
      class="secondary"
      id="exampleButton"
    >
      Charger un exemple
    </button>
    <img id="preview" alt="Aperçu de la photo">
  </div>
  <!-- OCR -->
  <div class="card">
    <h2>2. Reconnaissance du texte</h2>
    <button id="ocrButton">
      🔎 Reconnaître le texte
    </button>
    <div id="ocrStatus" class="status">
      Aucune image analysée.
    </div>
    <textarea
      id="text"
      placeholder="Le texte reconnu apparaîtra ici. Tu peux aussi le corriger manuellement."
    ></textarea>
  </div>
  <!-- COURS -->
  <div class="card">
    <h2>3. Générer le cours</h2>
    <button id="courseButton">
      📚 Générer le cours
    </button>
    <div id="course" class="course hidden"></div>
  </div>
  <!-- EXPORT -->
  <div class="card">
    <h2>4. Exporter</h2>
    <button id="exportTxt">
      📄 Export TXT
    </button>
    <button
      id="exportHtml"
      class="secondary"
    >
      🌐 Export HTML
    </button>
  </div>
</div>
<script>
let imageFile = null;
let generatedCourse = null;
/* =========================
   PHOTO
========================= */
document
  .getElementById("photo")
  .addEventListener("change", function(event) {
    imageFile = event.target.files[0];
    if (!imageFile) {
      return;
    }
    const preview = document.getElementById("preview");
    preview.src = URL.createObjectURL(imageFile);
    preview.style.display = "block";
    document.getElementById("ocrStatus").textContent =
      "Photo prête pour la reconnaissance.";
  });
/* =========================
   EXEMPLE
========================= */
document
  .getElementById("exampleButton")
  .addEventListener("click", function() {
    document.getElementById("text").value =
`La photosynthèse est le processus par lequel les plantes utilisent l'énergie lumineuse pour transformer le dioxyde de carbone et l'eau en matière organique.
Elle produit notamment du glucose et libère du dioxygène.
La photosynthèse se déroule principalement dans les chloroplastes des cellules végétales.
La chlorophylle joue un rôle essentiel dans la capture de l'énergie lumineuse.`;
    document.getElementById("ocrStatus").textContent =
      "Exemple chargé. Tu peux modifier le texte.";
  });
/* =========================
   OCR
========================= */
document
  .getElementById("ocrButton")
  .addEventListener("click", async function() {
    if (!imageFile) {
      document.getElementById("ocrStatus").textContent =
        "Choisis d'abord une photo.";
      return;
    }
    document.getElementById("ocrStatus").textContent =
      "Reconnaissance en cours…";
    /*
      L'application est volontairement conçue pour fonctionner
      même sans service OCR externe.
      Si aucun moteur OCR n'est disponible dans le navigateur,
      l'utilisateur peut saisir/coller le texte manuellement.
    */
    if (!window.Tesseract) {
      document.getElementById("ocrStatus").textContent =
        "Le moteur OCR n'est pas encore chargé. Tu peux saisir ou coller le texte ci-dessous.";
      return;
    }
    try {
      const result =
        await Tesseract.recognize(
          imageFile,
          "fra"
        );
      document.getElementById("text").value =
        result.data.text;
      document.getElementById("ocrStatus").textContent =
        "Reconnaissance terminée.";
    }
    catch (error) {
      document.getElementById("ocrStatus").textContent =
        "Impossible de reconnaître automatiquement le texte. Tu peux le saisir manuellement.";
    }
  });
/* =========================
   GENERATION DU COURS
========================= */
document
  .getElementById("courseButton")
  .addEventListener("click", function() {
    const raw =
      document
        .getElementById("text")
        .value
        .trim();
    if (!raw) {
      alert("Ajoute d'abord du texte.");
      return;
    }
    const sentences =
      raw
        .replace(/\s+/g, " ")
        .split(/(?<=[.!?])\s+/)
        .filter(Boolean);
    const title =
      sentences[0]
        ? sentences[0]
            .replace(/[.!?]$/, "")
            .slice(0, 100)
        : "Cours";
    const points =
      sentences.slice(0, 8);
    const words =
      raw
        .toLowerCase()
        .match(/[a-zàâçéèêëîïôûùüÿñæœ]{6,}/gi) || [];
    const keywords =
      [...new Set(words)]
        .slice(0, 10);
    generatedCourse = {
      title,
      summary: sentences.slice(0, 2).join(" "),
      points,
      keywords
    };
    afficherCours();
  });
/* =========================
   AFFICHAGE
========================= */
function afficherCours() {
  const course =
    document.getElementById("course");
  course.classList.remove("hidden");
  course.innerHTML = `
    <h3>${escapeHTML(generatedCourse.title)}</h3>
    <h4>À retenir</h4>
    <p>
      ${escapeHTML(generatedCourse.summary)}
    </p>
    <h4>Points essentiels</h4>
    <ul>
      ${generatedCourse.points
        .map(point =>
          `<li>${escapeHTML(point)}</li>`
        )
        .join("")}
    </ul>
    <h4>Mots-clés</h4>
    <div>
      ${generatedCourse.keywords
        .map(keyword =>
          `<span class="keyword">
            ${escapeHTML(keyword)}
          </span>`
        )
        .join("")}
    </div>
  `;
}
/* =========================
   SECURITE HTML
========================= */
function escapeHTML(text) {
  return text.replace(
    /[&<>"']/g,
    function(character) {
      const entities = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      };
      return entities[character];
    }
  );
}
/* =========================
   EXPORT
========================= */
function downloadFile(
  filename,
  content,
  type
) {
  const blob =
    new Blob(
      [content],
      { type }
    );
  const url =
    URL.createObjectURL(blob);
  const link =
    document.createElement("a");
  link.href = url;
  link.download = filename;
  link.click();
  setTimeout(
    () => URL.revokeObjectURL(url),
    1000
  );
}
/* EXPORT TXT */
document
  .getElementById("exportTxt")
  .addEventListener("click", function() {
    if (!generatedCourse) {
      alert("Génère d'abord le cours.");
      return;
    }
    const content =
`${generatedCourse.title}
À RETENIR
${generatedCourse.summary}
POINTS ESSENTIELS
${generatedCourse.points
  .map(point => "• " + point)
  .join("\n")}
MOTS-CLÉS
${generatedCourse.keywords.join(", ")}
`;
    downloadFile(
      "cours.txt",
      content,
      "text/plain;charset=utf-8"
    );
  });
/* EXPORT HTML */
document
  .getElementById("exportHtml")
  .addEventListener("click", function() {
    if (!generatedCourse) {
      alert("Génère d'abord le cours.");
      return;
    }
    const html = `
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>
${escapeHTML(generatedCourse.title)}
</title>
</head>
<body>
<h1>
${escapeHTML(generatedCourse.title)}
</h1>
<h2>
À retenir
</h2>
<p>
${escapeHTML(generatedCourse.summary)}
</p>
<h2>
Points essentiels
</h2>
<ul>
${generatedCourse.points
  .map(point =>
    `<li>${escapeHTML(point)}</li>`
  )
  .join("")}
</ul>
<h2>
Mots-clés
</h2>
<p>
${generatedCourse.keywords
  .map(escapeHTML)
  .join(" • ")}
</p>
</body>
</html>
`;
    downloadFile(
      "cours.html",
      html,
      "text/html;charset=utf-8"
    );
  });
/* =========================
   SERVICE WORKER
========================= */
if ("serviceWorker" in navigator) {
  window.addEventListener(
    "load",
    function() {
      navigator.serviceWorker
        .register("sw.js")
        .catch(
          error =>
            console.log(
              "Service Worker :",
              error
            )
        );
    }
  );
}
</script>
</body>
</html>
